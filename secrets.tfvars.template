# Template for terraform apply-time variables.
# COPY to secrets.tfvars (gitignored), fill ALL values, then run:
#   export GCP_PROJECT_ID=<your-project>
#   export BILLING_ACCOUNT_ID=<your-billing-account>
#   make apply
# NEVER commit secrets.tfvars — .gitignore covers it.

# --- Layer 1 (baseline) — the only layer that reads this file ---
# Dummy POC value for the demo secret projected via ESO. Rotate for anything real.
demo_api_key_value = ">>> INSERT YOUR VALUES: dummy POC value e.g. poc-key-v1 <<<"

# --- Variables passed via env → deploy.sh -var flags (NOT read from this file) ---
# GCP_PROJECT_ID     — export GCP_PROJECT_ID=your-project-id
# BILLING_ACCOUNT_ID — export BILLING_ACCOUNT_ID=XXXXXX-XXXXXX-XXXXXX
# BUCKET_SUFFIX      — export BUCKET_SUFFIX=your-suffix (default: last segment of project ID)
# REPO_URL           — export REPO_URL=https://github.com/USER/gke-gitops-platform.git
